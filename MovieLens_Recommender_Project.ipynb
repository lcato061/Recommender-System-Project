  {
   "cell_type": "code",
   "execution_count": 61,
   "metadata": {},
   "outputs": [],
   "source": [
    "#Baseline Model\n",
    "#Two attributes: movie popularity and number of genres\n",
    "#train_cla is already defined to be the feature vector\n",
    "train_label = train_df[\"liked\"]\n",
    "valid_label = valid_df[\"liked\"]\n",
    "\n",
    "baseline_cla = LogisticRegression(max_iter=2000, random_state=42, fit_intercept=False) #I included intercept earlier\n",
    "baseline_cla.fit(train_cla,train_label) \n",
    "baseline_valid_pred = baseline_cla.predict(valid_cla)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 62,
   "metadata": {},
   "outputs": [],
   "source": [
    "#Improved Model\n",
    "#Attributes: Baseline features + user activity + genre indicator\n",
    "#We're going to set the class_weight=\"balanced\" to force the logisitc loss approximately\n",
    "#equal among classes\n",
    "\n",
    "movie_count_size = train_df.groupby(\"movieId\").size()\n",
    "user_count_size = train_df.groupby(\"userId\").size()\n",
    "\n",
    "#convert pipe-separated genres into stable binary columns\n",
    "all_genres = sorted({\n",
    "    genre for value in movies[\"genres\"] for genre in value.split(\"|\")\n",
    "    if genre != \"(no genres listed)\"\n",
    "})\n",
    "\n",
    "def add_genre_indicator(f):\n",
    "    out = f.copy()\n",
    "    for genre in all_genres:\n",
    "        out[f\"genre__{genre}\"] = out[\"genres\"].str.contains(genre, regex=False).astype(int)\n",
    "    return out\n",
    "\n",
    "#Append the data with genre indicator\n",
    "train_df = add_genre_indicator(train_df)\n",
    "valid_df = add_genre_indicator(valid_df)\n",
    "test_df = add_genre_indicator(test_df)\n",
    "OGtrain_df = add_genre_indicator(OGtrain_df)\n",
    "\n",
    "#redefine the feature function and include additional attributes\n",
    "def feature2(d): \n",
    "    movie_num_rating = movie_count_size.get(d[\"movieId\"], 0) #movie popularity\n",
    "    user_num_rating = user_count_size.get(d[\"userId\"], 0) #user activity\n",
    "    feat = [1, movie_num_rating, d[\"num_genres\"], user_num_rating]  #1 is the offset (intercept) to account for bias\n",
    "    feat.extend([d[f\"genre__{genre}\"] for genre in all_genres]) # Append one binary feature for every genre\n",
    "    return feat #The feature function returns a list\n",
    "#NOTE: The offset is redundant here because LogisticRegression() already includes one, but I will force the intercept to be False. \n",
    "\n",
    "#Apply the feature function interatively on each row and build up feature matrix.\n",
    "train_cla2 = [feature2(row) for _, row in train_df.iterrows()]\n",
    "valid_cla2 = [feature2(row) for _, row in valid_df.iterrows()]\n",
    "test_cla2 = [feature2(row) for _, row in test_df.iterrows()]\n",
    "\n",
    "improved_cla = LogisticRegression(max_iter=2000, class_weight=\"balanced\", random_state=42, fit_intercept=False)\n",
    "improved_cla.fit(train_cla2, train_label)\n",
    "improved_valid_pred = improved_cla.predict(valid_cla2)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 63,
   "metadata": {},
   "outputs": [],
   "source": [
    "#Final classification evaluation\n",
    "#Using the BER as a metric for choosing the best model, the improved model (BER = 0.38)\n",
    "#performed better than the baseline model (BER = 0.42). We will fit the improved model on all \n",
    "#OGtrain_df data (train+validation) and evaluate once on the testing set. \n",
    "OGtrain_label = OGtrain_df[\"liked\"]\n",
    "test_label = test_df[\"liked\"]\n",
    "OGmovie_count_size = OGtrain_df.groupby(\"movieId\").size()\n",
    "OGuser_count_size = OGtrain_df.groupby(\"userId\").size()\n",
    "\n",
    "#redefine the feature function and include additional attributes\n",
    "def feature_final(d): \n",
    "    movie_num_rating = OGmovie_count_size.get(d[\"movieId\"], 0) #movie popularity\n",
    "    user_num_rating = OGuser_count_size.get(d[\"userId\"], 0) #user activity\n",
    "    feat = [1, movie_num_rating, d[\"num_genres\"], user_num_rating]  #1 is the offset (intercept) to account for bias\n",
    "    feat.extend([d[f\"genre__{genre}\"] for genre in all_genres]) # Append one binary feature for every genre\n",
    "    return feat #The feature function returns a list\n",
    "#NOTE: The offset is redundant here because LogisticRegression() already includes one, but I will force the intercept to be False. \n",
    "\n",
    "OGtrain_cla2 = [feature_final(row) for _, row in OGtrain_df.iterrows()]\n",
    "\n",
    "final_cla = LogisticRegression(max_iter=2000, class_weight=\"balanced\", random_state=42, fit_intercept=False)\n",
    "final_cla.fit(OGtrain_cla2, OGtrain_label)\n",
    "\n",
    "test_cla2_pred = final_cla.predict(test_cla2)"
   ]
