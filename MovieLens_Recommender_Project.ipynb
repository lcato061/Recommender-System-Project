    "#1. Predictions were done in the step above.\n",
    "#2. Compute the Accuracy, Balanced Accuracy, and BER. \n",
    "baseline_accuracy = accuracy_score(valid_label, baseline_valid_pred)\n",
    "baseline_valid_bal_acc = balanced_accuracy_score(valid_label, baseline_valid_pred)\n",
    "baseline_valid_BER = 1 - baseline_valid_bal_acc\n",
