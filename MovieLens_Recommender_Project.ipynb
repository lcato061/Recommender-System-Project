    "labels = recommendation_train[\"rating\"].tolist()\n",
    "\n",
    "result = scipy.optimize.fmin_l_bfgs_b(cost, [training_mean] + [0.0]*(nUsers+nMovies),\n",
    "                             derivative, args = (labels, 0.001))"
