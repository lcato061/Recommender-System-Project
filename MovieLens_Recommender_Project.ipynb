    "# Unique IDs from training data\n",
    "users = list(userRatings.keys())\n",
    "movies = list(movieRatings.keys())\n",
    "\n",
    "nUsers = len(users)\n",
    "nMovies = len(movies)\n",
    "N = len(recommendation_train)\n",
    "\n",
    "# Global mean rating\n",
    "training_mean = recommendation_train[\"rating\"].mean()\n",
    "\n",
    "# Bias parameters initialized at zero\n",
    "userBiases = defaultdict(float)\n",
    "movieBiases = defaultdict(float)\n",
    "\n",
    "print(\"N:\", N)\n",
    "print(\"Users:\", nUsers)\n",
    "print(\"Movies:\", nMovies)\n",
    "print(\"Training mean:\", training_mean)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 101,
   "metadata": {},
   "outputs": [],
   "source": [
    "#define the MSE function\n",
    "\n",
    "def MSE(predictions, labels):\n",
    "    #Add in an error flag for mismatched lengths\n",
    "    if len(predictions) != len(labels):\n",
    "        raise ValueError(f\"Length mismatch: {len(predictions)} predictions\" f\" and {len(labels)} labels\")\n",
    "    differences = [(x-y)**2 for x,y in zip(predictions,labels)]\n",
    "    return sum(differences) / len(differences)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 102,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Baseline trivial bias-model MSE: 1.08\n"
     ]
    }
   ],
   "source": [
    "#Baseline trivial Bias model\n",
    "alwaysPredictMean = [training_mean for _, row in test_df.iterrows()]\n",
    "\n",
    "labels = [row[\"rating\"] for _, row in test_df.iterrows()]\n",
    "\n",
    "baseline_MSE = MSE(alwaysPredictMean, labels)\n",
    "print(f\"Baseline trivial bias-model MSE: {baseline_MSE:.2f}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 103,
   "metadata": {},
   "outputs": [],
   "source": [
    "#Define the prediction function\n",
    "#The inital state has the bias variables set to 0, so it only considers the mean. \n",
    "def prediction(user, movie):\n",
    "    return training_mean + userBiases.get(user, 0.0) + movieBiases.get(movie, 0.0)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 104,
   "metadata": {},
   "outputs": [],
   "source": [
    "#Create a flat vector structure\n",
    "def unpack(theta):\n",
    "    global training_mean\n",
    "    global userBiases\n",
    "    global movieBiases \n",
    "    \n",
    "    training_mean = theta[0]\n",
    "    \n",
    "    userBiases = dict(zip(users, theta[1 : nUsers + 1]))\n",
    "    movieBiases = dict(zip(movies, theta[1 + nUsers : ]))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 105,
   "metadata": {},
   "outputs": [],
   "source": [
    "#Define the cost function, the function we want to optimize\n",
    "def cost(theta, labels, lamb):\n",
    "    unpack(theta)\n",
    "    predictions = [prediction(row[\"userId\"], row[\"movieId\"]) for _, row in recommendation_train.iterrows()]\n",
    "    cost = MSE(predictions, labels)\n",
    "    print(\"MSE = \" + str(cost))\n",
    "    for u in userBiases:\n",
    "        cost += lamb*userBiases[u]**2\n",
    "    for m in movieBiases:\n",
    "        cost += lamb*movieBiases[m]**2\n",
    "    return cost"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 106,
   "metadata": {},
   "outputs": [],
   "source": [
    "#Define the derivative function\n",
    "def derivative(theta, labels, lamb):\n",
    "    unpack(theta)\n",
    "    N = len(recommendation_train)\n",
    "    dalpha = 0\n",
    "    dUserBiases = defaultdict(float)\n",
    "    dMovieBiases = defaultdict(float)\n",
    "    for _, row in recommendation_train.iterrows():\n",
    "        user = row[\"userId\"]\n",
    "        movie = row[\"movieId\"]\n",
    " \n",
    "        pred = prediction(user, movie)\n",
    "        diff = pred - row[\"rating\"]\n",
    "        \n",
    "        dalpha += (2/N)*diff\n",
    "        dUserBiases[user] += (2/N)*diff\n",
    "        dMovieBiases[movie] += (2/N)*diff\n",
    "    for user in userBiases:\n",
    "        dUserBiases[user] += 2*lamb*userBiases[user]\n",
    "    for movie in movieBiases:\n",
    "        dMovieBiases[movie] += 2*lamb*movieBiases[movie]\n",
    "\n",
    "    #Return derivatives in the same order as used in the unpack() function\n",
    "    dtheta = [dalpha] + [dUserBiases[user] for user in users] + [dMovieBiases[movie] for movie in movies]\n",
    "    return np.array(dtheta)"
   ]
  },
  {
